# Copy to .env (cp .env.example .env) and fill in.  .env is git-ignored: NEVER commit it.
# Provider: openai | gemini | groq | ollama | mock   (mock = offline test mode, not for submission)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# The secret key. (OPENAI_API_KEY / GEMINI_API_KEY / GROQ_API_KEY are also accepted.)
LLM_API_KEY=
# Optional: override the provider's default OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=400
# Seconds to wait between calls (keeps free tiers under their rate limit)
LLM_REQUEST_DELAY=2

# Published pricing of LLM_MODEL - copy from the provider's pricing page ON THE DAY YOU RUN
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60
PRICE_CURRENCY=USD
PRICE_DATE=YYYY-MM-DD
PRICE_SOURCE_URL=https://openai.com/api/pricing/

# MLflow tracking server started by scripts/start_mlflow.sh
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
